{
  "name": "flowio-home-assistant-cards",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=dist/flowio-home-assistant-cards.js --servedir=. --serve=127.0.0.1:4173",
    "build": "npm run check && esbuild src/index.ts --bundle --format=esm --target=es2020 --minify --legal-comments=eof --metafile=dist/metafile.json --outfile=dist/flowio-home-assistant-cards.js",
    "release:prepare": "npm run build && node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "apexcharts": "4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "esbuild": "^0.24.2",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.51.1"
  }
}
